# Copy this file to backend/.env and adjust for your machine.
# backend/.env is ignored by Git. Never commit real credentials.

# Local development database started by the root docker-compose.yml.
# The port must match POSTGRES_PORT used by Compose (default 5432).
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_copilot

# Set to true to log every SQL statement.
DB_ECHO=false

# LLM providers used by the planner adapter (app/integrations/llm).
# Tried in order: Gemini, then Groq, then OpenRouter. Leave a key empty to skip it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
LLM_TIMEOUT_S=30
